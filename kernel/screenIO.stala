
func clear_screen do

	0 let row
	while row SCREEN_ROWS != do
		0 let col
		while col SCREEN_COLUMNS != do			

			col
			row SCREEN_COLUMNS * +
			SCREEN_BUFFER +	
			let addr

			addr 0 !8

			col ++ let col
		end
		row ++ let row
	end
end

func scroll_screen do

	0 set_col_cursor

	SCREEN_ROWS -- let row
	while row 0 != do
		0 let col
		while col SCREEN_COLUMNS != do		

			col
			row SCREEN_COLUMNS * +
			SCREEN_BUFFER +	
			let addr

			addr SCREEN_COLUMNS - ?8 let val

			addr val !8

			col ++ let col
		end
		row -- let row
	end

	# empty row
	0 let col
	while col SCREEN_COLUMNS != do		
		col
		SCREEN_BUFFER +	
		let addr
		addr 0 !8
		col ++ let col
	end

	update_screen
end

func update_screen do
	SCREEN_MEMORY let sm
	SCREEN_BUFFER let sb
	0 let i
	while i SCREEN_ROWS SCREEN_COLUMNS * != do
		sb ?8 let val
		sm val !8 # character
		sm ++ 0x0f !8 # color

		sb ++ let sb
		sm 2 + let sm
		i ++ let i
	end
end

func update_screen_character row col do
	col
	row SCREEN_COLUMNS * +
	let i
	
	SCREEN_BUFFER i + ?8 let val
	SCREEN_MEMORY i 2 * + val !8 # character
	SCREEN_MEMORY i 2 * ++ + 0x0f !8 # color
	i ++ let i
end

func feed_character char do
	get_col_cursor let cursor
	cursor SCREEN_COLUMNS < if
		SCREEN_BUFFER cursor + char !8
		0 cursor update_screen_character
		cursor ++ let cursor
	else
		#end of line
	end
	cursor set_col_cursor
end

func col_cursor_addr do "1234567" end
func set_col_cursor val do col_cursor_addr val !8 end
func get_col_cursor do col_cursor_addr ?8 end

func SCREEN_BUFFER  do 0x100000 end
func SCREEN_MEMORY  do 0xb8000 end # true address
func SCREEN_ROWS    do 25 end
func SCREEN_COLUMNS do 80 end

