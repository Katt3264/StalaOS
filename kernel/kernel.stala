include "stdlib/string.stala"
include "stdlib/x86_32_asm.stala"
include "kernel/screenIO.stala"
include "kernel/keyboard.stala"

include "kernel/programs/echo.stala"
include "kernel/programs/clear.stala"
include "kernel/programs/help.stala"
include "kernel/programs/disk.stala"


func main do
	
	clear_screen
	"Hello world!" feed_string
	scroll_screen

	while 1 do

		keyboard_pool let key_button
		
		key_button BTN_ENTER = if
			
			# copy input string to buffert
			SCREEN_BUFFER USER_INPUT_BUFFERT SCREEN_COLUMNS memcpy
			USER_INPUT_BUFFERT SCREEN_COLUMNS + 0 !8 # make sure last
			scroll_screen

			USER_INPUT_BUFFERT "ECHO " strstr USER_INPUT_BUFFERT = if
				USER_INPUT_BUFFERT run_program_echo	
			else USER_INPUT_BUFFERT "CLEAR" streq elif
				USER_INPUT_BUFFERT run_program_clear	
			else USER_INPUT_BUFFERT "HELP" streq elif
				USER_INPUT_BUFFERT run_program_help	
			else USER_INPUT_BUFFERT "DISK" strstr USER_INPUT_BUFFERT = elif
				USER_INPUT_BUFFERT run_program_disk	
			else
				"invalid command!" feed_string scroll_screen
				USER_INPUT_BUFFERT run_program_help
			end

			scroll_screen		

		else key_button BTN_BACKSPACE = elif
			feed_backspace
		else key_button 0 != elif
			key_button feed_character
		else
			# 0 character
		end

	end	
end

func USER_INPUT_BUFFERT do 
	"0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
end

func delay do
	1000000 let i
	while i -- let i i 0 != do end
end

















